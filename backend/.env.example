# Aurea System — backend environment. Copy to `.env` and fill real values.
# NEVER commit real secrets.

# --- Core ---
APP_NAME="Aurea System API"
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=postgresql://aurea:aurea@localhost:5433/aurea
DB_ECHO=false

# --- JWT / Auth ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGO=HS256
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
PASSWORD_RESET_TTL=3600
INVITATION_TTL=604800

# --- URLs / CORS ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Object storage (Cloudflare R2 / S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@aurea.example

# --- GitHub issue integration ---
# A personal access token with `repo` scope (classic) or Issues:write (fine-
# grained). Empty = the feature reports 503, never silently fakes an issue.
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=

# --- Rate limiting ---
LOGIN_RATE_LIMIT_PER_MINUTE=5
