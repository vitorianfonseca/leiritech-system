# LeiriTech — backend environment. Copy to `.env` and fill real values.
# NEVER commit real secrets.

# --- Core ---
APP_NAME="LeiriTech API"
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=postgresql://leiritech:leiritech@localhost:5433/leiritech
DB_ECHO=false

# --- JWT / Auth ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGO=HS256
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
PASSWORD_RESET_TTL=3600
INVITATION_TTL=604800

# --- URLs / CORS ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Object storage (Cloudflare R2 / S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@leiritech.example

# --- GitHub issue integration ---
# A personal access token with `repo` scope (classic) or Issues:write (fine-
# grained). Empty = the feature reports 503, never silently fakes an issue.
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=

# --- Rate limiting (per minute, per client) ---
LOGIN_RATE_LIMIT_PER_MINUTE=5
PASSWORD_FORGOT_RATE_LIMIT_PER_MINUTE=3
PUBLIC_TOKEN_RATE_LIMIT_PER_MINUTE=10
REFRESH_RATE_LIMIT_PER_MINUTE=30
CHANGE_PASSWORD_RATE_LIMIT_PER_MINUTE=5
INVITE_SEND_RATE_LIMIT_PER_MINUTE=10

# Reverse proxies in front of the app whose X-Forwarded-For entries may be
# trusted when deriving the client IP for rate limiting. 0 = ignore the header
# (correct for direct exposure). Set to 1 behind Railway/Render/nginx, otherwise
# every user shares one bucket and a single attacker can lock everyone out.
# NEVER set this higher than the real number of proxies: the extra entries are
# attacker-controlled and would let a client forge a fresh bucket per request.
TRUSTED_PROXY_COUNT=0
